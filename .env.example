# ============================================================================
# MCPGuard-ADK Environment Configuration
# Copy to .env: cp .env.example .env
# ============================================================================

# 1. Google AI Studio / Vertex AI Credentials
# Run locally for $0 using a free Google AI Studio key (Gemini 3.8 Flash / 3.1 Flash-Lite:
# ~10 RPM, 1,500 RPD resetting midnight PT; returns HTTP 429 without unexpected charges).
GEMINI_API_KEY="your-google-ai-studio-api-key"
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# 2. Model Tiering Overrides (Supports Gemini 3.x & Gemini 4 Hydrogen / Argon / Carbon)
# Example Gemini 4 profile: Hydrogen (triage), Argon (audit), Carbon (escalation)
MCPGUARD_TRIAGE_MODEL="gemini-3.1-flash-lite"
MCPGUARD_AUDIT_MODEL="gemini-3.8-flash"
MCPGUARD_ESCALATION_MODEL="gemini-3.1-pro-preview"
MCPGUARD_LIVE_VOICE_MODEL="gemini-live-2.5-flash-preview"

# 3. OpenTelemetry & Cloud Trace Instrumentation (ADK Python v1.17.0+ / v2.0.0)
# IMPORTANT: Keep OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT='EVENT_ONLY'.
# Setting it to 'true' breaks trace and log collection under gen_ai_latest_experimental.
OTEL_SEMCONV_STABILITY_OPT_IN="gen_ai_latest_experimental"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="EVENT_ONLY"
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS="false"
OTEL_SERVICE_NAME="mcpguard-adk"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# 4. A2A Protocol v1.0 & Webhook Security
MCPGUARD_A2A_HOST="127.0.0.1"
MCPGUARD_A2A_PORT="8080"
MCPGUARD_A2A_SIGNING_KEY_ID="mcpguard-ed25519-2026-11"
MCPGUARD_A2A_WEBHOOK_ALLOWED_DOMAINS="ci.example.com,hooks.internal.example.org"
